<div id="dh-horde-hud-root">
  <div class="dh-info-banner">
    <strong>{{tokenName}}</strong>
    {{#if hasGroup}}
      — {{localize "DHHORDE.Hud.Horde" count=memberCount}}
    {{else}}
      — {{localize "DHHORDE.Hud.ReadyToMultiply"}}
    {{/if}}
  </div>

  <div class="dh-horde-actions">

    {{!-- Multiply: only when no group exists yet --}}
    {{#unless hasGroup}}
    <button type="button" class="dh-btn dh-btn-green" data-action="multiply">
      <i class="fas fa-clone"></i> {{localize "DHHORDE.Hud.Multiply"}}
    </button>
    {{/unless}}

    {{!-- Move buttons: only when group exists --}}
    {{#if hasGroup}}
      {{#if hasTargets}}
        <button type="button" class="dh-btn dh-btn-blue" data-action="move-close">
          <i class="fas fa-shoe-prints"></i> {{localize "DHHORDE.Hud.MoveClose"}}
        </button>
        <button type="button" class="dh-btn dh-btn-indigo" data-action="move-far">
          <i class="fas fa-running"></i> {{localize "DHHORDE.Hud.MoveFar"}}
        </button>
        <button type="button" class="dh-btn dh-btn-amber" data-action="move-all">
          <i class="fas fa-bolt"></i> {{localize "DHHORDE.Hud.MoveAll"}}
        </button>
      {{else}}
        <div class="dh-hint">
          <i class="fas fa-crosshairs"></i> {{localize "DHHORDE.Hud.TargetHint"}}
        </div>
      {{/if}}

      <button type="button" class="dh-btn dh-btn-red" data-action="dissolve">
        <i class="fas fa-skull"></i> {{localize "DHHORDE.Hud.Dissolve"}}
      </button>
    {{/if}}

    <hr class="dh-divider">

    <button type="button" class="dh-btn dh-btn-ghost" data-action="open-dashboard">
      <i class="fas fa-th-list"></i> {{localize "DHHORDE.Hud.Dashboard"}}
    </button>
  </div>
</div>
